# --- ACO Worker ---
#
# Simpan sebagai aco-worker/.env lalu: chmod 600 aco-worker/.env
# File ini TIDAK boleh di-commit (sudah masuk .gitignore).

# --- Supabase (SAMA dengan yang di Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Kunci enkripsi wallet ---
# WAJIB SAMA PERSIS dengan WALLET_ENCRYPTION_KEY di Vercel.
# Kalau beda, worker tidak bisa mendekripsi wallet yang diimpor lewat website.
# Bikin sekali dengan: openssl rand -base64 32
WALLET_ENCRYPTION_KEY=

# --- Ambil API key OpenSea dari website (disarankan) ---
# Website mengelola API key OpenSea: dibuat otomatis, dicek umurnya tiap user
# login, dirotasi sebelum kedaluwarsa. Worker mengambilnya lewat endpoint
# internal, jadi tidak perlu diedit manual tiap rotasi.
#
# WORKER_SHARED_SECRET harus SAMA dengan yang di Vercel.
# Bikin dengan: openssl rand -base64 32
WEBSITE_URL=https://kizunafnf.vercel.app
WORKER_SHARED_SECRET=

# Cadangan: kalau punya API key OpenSea sendiri, isi di sini. Dipakai hanya
# kalau pengambilan dari website dan dari database dua-duanya gagal.
OPENSEA_API_KEY=

# --- RPC ---
# TIDAK WAJIB. Tiap chain sudah punya RPC publik default (lihat lib/chains.js),
# dan user bisa menyimpan RPC sendiri per chain di halaman /aco.
# Yang di bawah ini cuma cadangan terakhir untuk chain tanpa default.
RPC_URL=

# --- Opsional ---
# Interval polling job baru (ms). Default 5000.
POLL_INTERVAL_MS=5000
# Nama worker di log. Berguna kalau nanti jalan lebih dari satu.
WORKER_ID=vps-utama
# CATATAN: MAX_LATE_MS sudah tidak dipakai lagi (diabaikan kalau masih ada).
# Dulu job digagalkan kalau waktu buka stage sudah lewat. Sekarang job tetap
# jalan selama stage masih BUKA — yang menggagalkan hanya stage yang sudah
# TUTUP. Itu perilaku yang benar: mint masih bisa selama window terbuka.
