# --- Supabase (https://app.supabase.com > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (login username + password) ---
# Kunci buat tanda tangan token sesi (HMAC-SHA256). WAJIB diisi.
# Bikin dengan: openssl rand -base64 48
# Kalau nilai ini diganti, SEMUA user langsung ter-logout.
AUTH_SESSION_SECRET=

# --- ACO (auto checkout / auto-mint) ---
# Kunci enkripsi private key wallet member (AES-256-GCM).
# Bikin dengan: openssl rand -base64 32
#
# WAJIB SAMA PERSIS dengan WALLET_ENCRYPTION_KEY di aco-worker/.env di VPS.
# Kalau beda, worker tidak bisa mendekripsi wallet yang diimpor lewat website.
#
# KALAU NILAI INI HILANG, SEMUA WALLET TERSIMPAN JADI SAMPAH — tidak ada
# recovery. Simpan cadangannya di password manager.
WALLET_ENCRYPTION_KEY=

# Shared secret buat endpoint internal /api/internal/opensea-key, yang dipakai
# worker VPS untuk mengambil API key OpenSea terkelola.
# Bikin dengan: openssl rand -base64 32
# Harus sama dengan WORKER_SHARED_SECRET di aco-worker/.env.
WORKER_SHARED_SECRET=

# --- Bot Discord (webhook auto-sync garapan) ---
# String acak, sama persis dipakai di bot/.env
RAFFLE_WEBHOOK_SECRET=

# --- Email buat Request Collab (SMTP) ---
# Contoh pakai Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=email kalian, SMTP_PASS=App Password (bukan password akun biasa)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email tujuan notifikasi collab request masuk
COLLAB_NOTIFY_EMAIL=

# --- CATATAN: env Discord OAuth sudah TIDAK DIPAKAI ---
# Login sekarang username+password, akun dibuat lewat bot Discord.
# Yang berikut boleh dihapus dari Vercel:
#   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_GUILD_ID,
#   DISCORD_ADMIN_ROLE_IDS, NEXTAUTH_URL, NEXTAUTH_SECRET
#
# Kecuali: kalau AUTH_SESSION_SECRET belum di-set, kode masih mau memakai
# NEXTAUTH_SECRET sebagai cadangan. Lebih baik set AUTH_SESSION_SECRET.
