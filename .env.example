# --- Discord OAuth App (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID server Discord komunitas kalian (klik kanan nama server > Copy Server ID)
DISCORD_GUILD_ID=

# ID role yang boleh akses panel admin (klik kanan role > Copy Role ID)
# Bisa lebih dari satu, dipisah koma. Contoh: "111111,222222"
DISCORD_ADMIN_ROLE_IDS=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Supabase (https://app.supabase.com > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot Discord (webhook auto-sync) ---
# String acak, sama persis dipakai di bot/.env
RAFFLE_WEBHOOK_SECRET=

# --- Email buat Request Collab (SMTP) ---
# Contoh pakai Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=email kalian, SMTP_PASS=App Password (bukan password akun biasa)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email tujuan notifikasi collab request masuk
COLLAB_NOTIFY_EMAIL=
