DISCORD_BOT_TOKEN=

# Application ID bot (Discord Developer Portal > General Information).
# Dibutuhkan buat `node deploy-commands.js`.
DISCORD_CLIENT_ID=

# Kalau di-set, slash command didaftarkan cuma ke server ini dan langsung
# muncul (cocok buat testing). Kosongkan buat daftar global (~1 jam menyebar).
REGISTER_GUILD_ID=

# --- Forwarder garapan (fitur lama) ---
# Isi channel ID yang mau dipantau. Boleh isi salah satu, dua, atau semuanya
# -- yang kosong otomatis gak dipantau, gak akan error.
RAFFLE_CHANNEL_ID=
NFT_CHANNEL_ID=
AIRDROP_CHANNEL_ID=
MINT_CHANNEL_ID=

WEBSITE_URL=https://kizunafnf.vercel.app

# Sama persis dengan RAFFLE_WEBHOOK_SECRET yang di-set di Vercel
RAFFLE_WEBHOOK_SECRET=

# --- Command akun website (/register, /reset-device, dll) ---
# Channel tempat command akun boleh dipakai. Kalau dikosongkan, command bisa
# dipakai di channel mana saja.
AUTH_CHANNEL_ID=

# Supabase. Sama dengan yang di Vercel.
# Bot butuh SERVICE ROLE key karena tabel app_users dikunci RLS.
# JANGAN pernah commit nilai ini.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
