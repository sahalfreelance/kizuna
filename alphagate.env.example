# --- Alphagate -> Kizuna /alpha forwarder ---
#
# Simpan file ini sebagai:  /root/alphagate.env
# Sudah masuk .gitignore, jadi aman dari commit.
#
# Cara pakai manual:
#     set -a; . /root/alphagate.env; set +a
#     python3 /root/alpha_forwarder.py --dry-run

# Cookie session Alphagate.
# Ambil dari browser: DevTools (F12) > Network > klik request apa pun ke
# api.alphagate.io > tab Headers > Request Headers > baris "Cookie".
# Copy HANYA bagian userId=... nya.
# Perlu diganti kalau session expired (biasanya beberapa minggu).
ALPHAGATE_COOKIE="userId=s%3A..."

# Website tujuan
KIZUNA_URL="https://kizunafnf.vercel.app"

# WAJIB sama persis dengan RAFFLE_WEBHOOK_SECRET di Environment Variables Vercel.
# Kalau beda, semua request dibalas 401.
KIZUNA_WEBHOOK_SECRET=""
